{
  "name": "@shunyasasaki/mkserve",
  "version": "0.0.0",
  "description": "Serve a workspace of Markdown files with a live-reloading preview.",
  "keywords": [
    "cli",
    "katex",
    "markdown",
    "mermaid",
    "preview",
    "server"
  ],
  "homepage": "https://github.com/shunya-sasaki/mkserve#readme",
  "bugs": {
    "url": "https://github.com/shunya-sasaki/mkserve/issues"
  },
  "license": "MIT",
  "author": "Shunya Sasaki",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shunya-sasaki/mkserve.git"
  },
  "bin": {
    "mkserve": "./dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "vp pack && vp build",
    "dev": "vp pack --watch",
    "dev:client": "vp dev",
    "test": "vp test",
    "lint": "vp lint",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check",
    "typecheck": "tsc --noEmit",
    "check": "vp check",
    "prepublishOnly": "vp run build && vp test"
  },
  "dependencies": {
    "@fastify/static": "^10.1.5",
    "@shikijs/rehype": "^4.5.0",
    "chokidar": "^5.0.0",
    "citty": "^0.2.2",
    "consola": "^3.4.2",
    "fastify": "^5.12.5",
    "get-port": "^7.2.0",
    "hast-util-to-string": "^3.0.1",
    "ignore": "^7.0.11",
    "katex": "^0.18.10",
    "open": "^11.0.4",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-github-blockquote-alert": "^2.1.0",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shiki": "^4.5.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "vfile": "^6.0.3"
  },
  "devDependencies": {
    "@iconify-json/devicon": "^1.2.68",
    "@iconify-json/fa7-brands": "^1.2.4",
    "@iconify-json/fa7-regular": "^1.2.3",
    "@iconify-json/fa7-solid": "^1.2.5",
    "@iconify-json/fluent-emoji-flat": "^1.2.6",
    "@iconify-json/logos": "^1.2.15",
    "@iconify-json/material-icon-theme": "^1.2.70",
    "@iconify-json/noto": "^1.2.9",
    "@iconify-json/selfhst": "^1.2.22",
    "@iconify-json/simple-icons": "^1.2.98",
    "@iconify-json/thesvg": "^1.2.8",
    "@iconify-json/thesvg-color": "^1.2.15",
    "@iconify-json/twemoji": "^1.2.5",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.3",
    "mermaid": "^12.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0",
    "vite-plus": "^1.0.0"
  },
  "engines": {
    "node": ">=20.19"
  },
  "packageManager": "pnpm@10.32.1",
  "pnpm": {
    "overrides": {
      "vite@*": "npm:@voidzero-dev/vite-plus-core@1.0.0",
      "vitest@*": "5.0.1"
    }
  }
}
